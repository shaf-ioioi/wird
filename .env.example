# Wird Backend — environment variables template
# Copy to .env and fill in values; never commit .env

DATABASE_URL=postgres://wird_user:password@localhost:5432/wird_db
NODE_ENV=development
PORT=3000

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email provider for magic links (Resend, SendGrid, etc.)
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/login?token=
EMAIL_FROM=noreply@wird.app
